# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Database Configuration (MongoDB & Supabase Support)
MONGODB_URI="mongodb+srv://username:password@cluster0.mongodb.net/foodhub"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Authentication & Initial Admin Provisioning Configuration
JWT_SECRET="foodhub_production_jwt_secret_key_change_in_prod"
JWT_EXPIRES_IN="7d"
INITIAL_ADMIN_EMAIL="admin@foodhub.com"
INITIAL_ADMIN_PASSWORD="your_secure_admin_password"
INITIAL_ADMIN_TOTP_SECRET="JBSWY3DPEHPK3PXP"

# Frontend & Backend URLs
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"

# Cloudinary Configuration (Food Image Uploads)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Email Notification Provider Configuration
